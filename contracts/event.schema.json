{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbansense.local/contracts/event.schema.json",
  "title": "UrbanSense Pothole Sighting Event",
  "description": "A single tracked pothole detection emitted by the ML pipeline to the pothole-events topic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "class",
    "bbox",
    "confidence",
    "gps_lat",
    "gps_lon",
    "timestamp",
    "track_id",
    "viewpoint_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique event identifier."
    },
    "class": {
      "type": "string",
      "const": "pothole",
      "description": "Detected road-defect class for this single-class MVP."
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": { "type": "number", "minimum": 0, "description": "Left pixel coordinate." },
        "y1": { "type": "number", "minimum": 0, "description": "Top pixel coordinate." },
        "x2": { "type": "number", "minimum": 0, "description": "Right pixel coordinate." },
        "y2": { "type": "number", "minimum": 0, "description": "Bottom pixel coordinate." }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "gps_lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "gps_lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "timestamp": { "type": "string", "format": "date-time", "description": "UTC detection time." },
    "track_id": { "type": "string", "minLength": 1, "description": "ByteTrack identity within the source stream." },
    "viewpoint_id": { "type": "string", "minLength": 1, "description": "Identifier for the independent camera, bus, or capture pass." }
  }
}
